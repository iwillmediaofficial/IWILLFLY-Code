{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iwillfly",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Builds the app before every deploy, so Cloudflare needs no separate build command.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /shop/* and /mall/* get SEO tags added by the Worker (worker/seo.ts), which also builds the sitemap and robots.txt.
    "run_worker_first": ["/api/*", "/shop/*", "/mall/*", "/sitemap.xml", "/robots.txt"],
  },
  // Images are written through this binding by /api/upload (worker/upload.ts).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "iwillfly-media" }],
  // Sends queued web push notifications every 2 minutes (worker/push.ts).
  "triggers": { "crons": ["*/2 * * * *"] },
  // Variables and secrets are set in the Cloudflare dashboard; deploys must not wipe them.
  "keep_vars": true,
  // Lets Workers Builds run `wrangler preview` for pull request branches. Top-level settings apply to previews too.
  "previews": {},
  "observability": { "enabled": true },
}
